# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored; never commit real credentials.
# ---------------------------------------------------------------------------

# Which environment to target: dev (default) or production
TEST_ENV=dev

# Per-environment roots. DEV_BASE_URL is REQUIRED - the suite refuses to start
# without it rather than guess a target.
DEV_BASE_URL=https://organization.dev.blueshirt.work
PROD_BASE_URL=https://organization.blueshirt.work


E2E_AUDIENCE_GROUP=E2E Audience

# --- dev -------------------------------------------------------------------
E2E_DEV_ORG_ADMIN_EMAIL=
E2E_DEV_ORG_ADMIN_PASSWORD=


E2E_DEV_DIVISION_OFFICER_EMAIL=
E2E_DEV_DIVISION_OFFICER_PASSWORD=

E2E_DEV_DISTRICT_SUPERVISOR_EMAIL=
E2E_DEV_DISTRICT_SUPERVISOR_PASSWORD=

E2E_DEV_PRINCIPAL_EMAIL=
E2E_DEV_PRINCIPAL_PASSWORD=

E2E_DEV_MASTER_TEACHER_EMAIL=
E2E_DEV_MASTER_TEACHER_PASSWORD=

E2E_DEV_COACH_EMAIL=
E2E_DEV_COACH_PASSWORD=

