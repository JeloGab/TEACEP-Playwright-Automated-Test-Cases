# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored; never commit real credentials.
# ---------------------------------------------------------------------------

# Which environment to target: dev (default) or production
TEST_ENV=dev

# Per-environment roots. DEV_BASE_URL is REQUIRED - the suite refuses to start
# without it rather than guess a target.
DEV_BASE_URL=https://organization.dev.blueshirt.work
PROD_BASE_URL=https://organization.blueshirt.work

# One-off override that beats every config file (handy for preview deploys)
# BASE_URL=

# Set to 1 to allow specs that create / archive / delete real records.
# Always on for dev. Leave this commented out: setting it here would arm
# destructive specs for a production run too.
# ALLOW_DESTRUCTIVE=1

# --- Shared fixtures the signed-in specs expect ----------------------------
# An existing audience group the Configure-and-Run cases send surveys to.
E2E_AUDIENCE_GROUP=E2E Audience

# The superior that TCP - NU - ORPHT attaches an orphan member to.
# E2E_SUPERIOR_NAME=

# --- Role credentials ------------------------------------------------------
# Accounts differ between dev and production, so each environment has its own
# keys. There is no fallback between them on purpose: a dev run will never
# reach for a production account.
#
# A role whose pair is empty skips itself, so fill these in one role at a
# time and the suite stays green.
#
# TEST_ENV=dev        uses the E2E_DEV_*  keys
# TEST_ENV=production uses the E2E_PROD_* keys
#
# MFA
# An account enrolled in an authenticator also needs its base32 secret, or its
# login cannot be automated:
#     E2E_DEV_ORG_ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP
#
# SEVERAL ACCOUNTS IN ONE ROLE
# Account 1 is the plain key. Extra accounts are numbered, up to 9:
#     E2E_DEV_ORG_ADMIN_EMAIL=
#     E2E_DEV_ORG_ADMIN_2_EMAIL=
# Each account gets its own cached session, so two accounts in the same role
# never share cookies. Add a numbered pair for any role that needs one.

# --- dev -------------------------------------------------------------------
E2E_DEV_ORG_ADMIN_EMAIL=
E2E_DEV_ORG_ADMIN_PASSWORD=
# E2E_DEV_ORG_ADMIN_TOTP_SECRET=

# a second Org Admin, for checking one admin's records stay out of another's view
E2E_DEV_ORG_ADMIN_2_EMAIL=
E2E_DEV_ORG_ADMIN_2_PASSWORD=

E2E_DEV_DIVISION_OFFICER_EMAIL=
E2E_DEV_DIVISION_OFFICER_PASSWORD=

E2E_DEV_DISTRICT_SUPERVISOR_EMAIL=
E2E_DEV_DISTRICT_SUPERVISOR_PASSWORD=

E2E_DEV_PRINCIPAL_EMAIL=
E2E_DEV_PRINCIPAL_PASSWORD=

E2E_DEV_MASTER_TEACHER_EMAIL=
E2E_DEV_MASTER_TEACHER_PASSWORD=

E2E_DEV_COACH_EMAIL=
E2E_DEV_COACH_PASSWORD=

E2E_DEV_SUPPORT_EMAIL=
E2E_DEV_SUPPORT_PASSWORD=

# Teacher has no option in the signup Title dropdown - see config/roles.ts.
# A Teacher account has to be invited, not self-registered.
E2E_DEV_TEACHER_EMAIL=
E2E_DEV_TEACHER_PASSWORD=

# --- production ------------------------------------------------------------
E2E_PROD_ORG_ADMIN_EMAIL=
E2E_PROD_ORG_ADMIN_PASSWORD=
# E2E_PROD_ORG_ADMIN_TOTP_SECRET=

# a second Org Admin, for checking one admin's records stay out of another's view
E2E_PROD_ORG_ADMIN_2_EMAIL=
E2E_PROD_ORG_ADMIN_2_PASSWORD=

E2E_PROD_DIVISION_OFFICER_EMAIL=
E2E_PROD_DIVISION_OFFICER_PASSWORD=

E2E_PROD_DISTRICT_SUPERVISOR_EMAIL=
E2E_PROD_DISTRICT_SUPERVISOR_PASSWORD=

E2E_PROD_PRINCIPAL_EMAIL=
E2E_PROD_PRINCIPAL_PASSWORD=

E2E_PROD_MASTER_TEACHER_EMAIL=
E2E_PROD_MASTER_TEACHER_PASSWORD=

E2E_PROD_COACH_EMAIL=
E2E_PROD_COACH_PASSWORD=

E2E_PROD_SUPPORT_EMAIL=
E2E_PROD_SUPPORT_PASSWORD=

E2E_PROD_TEACHER_EMAIL=
E2E_PROD_TEACHER_PASSWORD=
