{
  "name": "teacep-test-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright end-to-end tests for the Blueshirt Survey System",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "dotenv": "^17.4.2",
    "typescript": "^5.9.2"
  }
}
